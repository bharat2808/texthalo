# Neon Auth URL is public browser configuration, not a secret.
VITE_NEON_AUTH_URL=https://ep-hidden-moon-b4ppme87.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# Local development uses the Node API. Set this to the deployed TextHalo API before building production.
VITE_TEXTHALO_API_URL=http://localhost:8788
# Public Cloudflare Turnstile sitekey; localhost signup bypasses the challenge.
VITE_TURNSTILE_SITE_KEY=

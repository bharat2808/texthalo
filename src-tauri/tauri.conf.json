{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextHalo",
  "mainBinaryName": "texthalo",
  "version": "0.1.23",
  "identifier": "com.kiegen.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TextHalo",
        "width": 780,
        "height": 640,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "Developer ID Application: Bharat Bharat (BQVR37A9HG)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "14.0",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/fr-CA.lproj/InfoPlist.strings": "locales/fr-CA.lproj/InfoPlist.strings",
        "Resources/es-419.lproj/InfoPlist.strings": "locales/es-419.lproj/InfoPlist.strings",
        "Resources/licenses": "licenses",
        "Resources/pt-BR.lproj/InfoPlist.strings": "locales/pt-BR.lproj/InfoPlist.strings",
        "Resources/it.lproj/InfoPlist.strings": "locales/it.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "locales/ja.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "locales/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "locales/zh-Hant.lproj/InfoPlist.strings"
      }
    },
    "category": "Productivity",
    "shortDescription": "Speak any selected text, from anywhere",
    "longDescription": "TextHalo lives in the menu bar. Select text in any app, press a shortcut, and hear it read aloud. Requires Accessibility permission to read the selection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/texthalo-assistant",
      "binaries/reader-host"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNDVENEEwMTY5OEQ3QTMKUldTajE1Z1dvTlJGdkd3K0ZqZWM5ZS9mTjMvc2FncnpIRzRzRVNjaHBIWTBNcGVRc3pMNnlBUm8K",
      "endpoints": [
        "https://storage.texthalo.app/updates/v2/latest.json"
      ]
    }
  }
}

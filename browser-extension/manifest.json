{
  "manifest_version": 3,
  "name": "TextHalo Reader",
  "version": "0.4.0",
  "description": "Control local Kindle audiobook creation and playback through the TextHalo Mac app.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://read.amazon.ca/*",
    "https://read.amazon.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TextHalo Reader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.ca/*",
        "https://read.amazon.com/*"
      ],
      "js": [
        "kindle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
